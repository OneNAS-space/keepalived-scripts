#!/bin/sh
#
# /etc/hotplug.d/keepalived/560-keepalived-scripts
#
# Supplement for keepalived on OpenWrt. Run by hotplug-call after the stock
# hotplug scripts (01-ubus, 5xx service scripts, ...) with ACTION, TYPE and
# NAME in the environment. Replaces the former /etc/keepalived.user, which is
# owned by the keepalived package.
#
# What happens in each vrrp_sync_group state is configured in
# /etc/config/keepalived_scripts: one section per state (master, backup,
# fault, shutdown) with an action per service, "on", "off" or "keep" (leave
# it as it is). Without the file, or for an option it lacks, the built-in
# defaults apply, which are:
#   MASTER : DHCPv4 on (option 3/6 -> LAN VIP), DHCPv6/RA on, natmap on,
#            cloudflared off, lease_sync (push to peer) on; first takes the
#            peer's leases and dhcp config
#   BACKUP : DHCP off but dnsmasq keeps running (DNS only), natmap off,
#            cloudflared on, lease_sync off
#   FAULT  : natmap and cloudflared off, lease_sync off, DHCP left unchanged
#
# Requires the keepalived-sync hotplug script 551-dnsmasq NOT to stop dnsmasq
# on BACKUP (see local-patches in the keepalived fork).
#
# Everything lives in functions with one entry point at the bottom, and
# helpers are prefixed with ks_, so it behaves the same whether hotplug-call
# sources or executes it and does not clash with the stock hotplug library.

KS_SCRIPTS_DIR="/etc/keepalived/scripts"
KS_INITIAL_FLAG="/tmp/keepalived_initial_start"
# Written by the stock 01-ubus hotplug script: <NAME>_<TYPE>/STATUS
KS_STATUS_DIR="/var/run/keepalived"
# keepalived always starts in BACKUP and may become MASTER within seconds
KS_SETTLE_DELAY=5

ks_log() {
	logger -t keepalived-scripts "$*"
}

# --- Configuration (/etc/config/keepalived_scripts) ---
KS_CONFIG="keepalived_scripts"

# built-in default of an action: <state>:<service>
ks_default() {
	case "$1:$2" in
		master:cloudflared | backup:dhcpv4 | backup:dhcpv6 | backup:natmap | backup:lease_sync | \
		fault:natmap | fault:lease_sync | fault:cloudflared | \
		shutdown:natmap | shutdown:cloudflared)
			echo off ;;
		fault:dhcpv4 | fault:dhcpv6 | fault:dnsmasq | shutdown:dnsmasq)
			echo keep ;;
		*)
			echo on ;;
	esac
}

# ks_cfg <section> <option> <default>
ks_cfg() {
	local value

	value=$(uci -q get "$KS_CONFIG.$1.$2" 2>/dev/null)
	if [ -n "$value" ]; then
		echo "$value"
	else
		echo "$3"
	fi
}

# on | off | keep, built-in default when unset or not understood
ks_action() {
	local def value

	def=$(ks_default "$1" "$2")
	value=$(ks_cfg "$1" "$2" "$def")
	case "$value" in
		on | 1 | yes | true) echo on ;;
		off | 0 | no | false) echo off ;;
		keep) echo keep ;;
		*)
			ks_log "Invalid value '$value' for $KS_CONFIG.$1.$2, using '$def'"
			echo "$def"
			;;
	esac
}

# 1 | 0 for a plain switch
ks_flag() {
	case "$(ks_cfg "$1" "$2" "$3")" in
		1 | on | yes | true) echo 1 ;;
		0 | off | no | false) echo 0 ;;
		*) echo "$3" ;;
	esac
}

# Every DHCP action works on the "lan" section of /etc/config/dhcp (the
# OpenWrt default). Without it there is nothing to switch: say so, once.
KS_LAN_CHECKED=""
ks_have_lan() {
	if [ -z "$KS_LAN_CHECKED" ]; then
		if uci -q get dhcp.lan >/dev/null 2>&1; then
			KS_LAN_CHECKED=yes
		else
			KS_LAN_CHECKED=no
			ks_log "ERROR: section dhcp.lan does not exist, DHCP actions are skipped"
		fi
	fi
	[ "$KS_LAN_CHECKED" = yes ]
}

# --- Generic UCI helper: only write to flash when the value really changes ---
ks_check_and_update() {
	local config_key="$1"
	local target_value="$2"
	local current_value

	current_value=$(uci -q get "$config_key" 2>/dev/null)

	if [ "$current_value" != "$target_value" ]; then
		ks_log "Updating $config_key from $current_value to $target_value"
		uci set "$config_key=$target_value"
		uci commit "${config_key%%.*}" 2>/dev/null || ks_log "Error committing ${config_key%%.*}"
	else
		ks_log "$config_key is already set to $target_value, skipping"
	fi
}

# --- Generic service helpers ---
ks_start_service_if_needed() {
	local svc="$1"

	if /etc/init.d/"$svc" running >/dev/null 2>&1; then
		ks_log "$svc service is already running, skipping start"
	else
		ks_log "***** Starting $svc service *****"
		/etc/init.d/"$svc" restart 2>/dev/null || ks_log "Error starting $svc"
	fi
}

ks_stop_service() {
	local svc="$1"

	ks_log "***** Stopping $svc service *****"
	/etc/init.d/"$svc" stop 2>/dev/null || ks_log "Error stopping $svc"
}

# --- natmap ---
ks_enable_natmap() {
	if ! command -v natmap >/dev/null 2>&1; then
		ks_log "natmap is not installed, skipping natmap control"
		return 0
	fi
	ks_check_and_update "natmap.@global[0].enable" "1"
	ks_start_service_if_needed natmap
}

ks_disable_natmap() {
	if ! command -v natmap >/dev/null 2>&1; then
		ks_log "natmap is not installed, skipping natmap control"
		return 0
	fi
	ks_check_and_update "natmap.@global[0].enable" "0"
	ks_stop_service natmap
}

# --- cloudflared ---
ks_enable_cloudflared() {
	if ! command -v cloudflared >/dev/null 2>&1; then
		ks_log "cloudflared is not installed, skipping cloudflared control"
		return 0
	fi
	ks_check_and_update "cloudflared.config.enabled" "1"
	ks_start_service_if_needed cloudflared
}

ks_disable_cloudflared() {
	if ! command -v cloudflared >/dev/null 2>&1; then
		ks_log "cloudflared is not installed, skipping cloudflared control"
		return 0
	fi
	ks_check_and_update "cloudflared.config.enabled" "0"
	ks_stop_service cloudflared
}

# --- dhcp.lan helpers ---
ks_dhcp_lan() {
	uci -q get "dhcp.lan.$1" 2>/dev/null
}

# dhcp.lan.dhcp_option is a list that belongs to the user. The two entries
# that carry the LAN VIP (gateway 3, DNS 6) are ours; everything else in it is
# left exactly as it is. (sync_leases.sh keeps the same entries local, see
# KEEP_LOCAL_DEFAULT there.)
KS_NL="
"

ks_is_vip_option() {
	case "$1" in
		3,* | 6,* | option:router,* | option:dns-server,*) return 0 ;;
	esac
	return 1
}

# Print the entries of dhcp.lan.dhcp_option, one per line
ks_dhcp_options() {
	local raw entry

	raw=$(uci -q show dhcp.lan.dhcp_option 2>/dev/null)
	[ -n "$raw" ] || return 0
	# "dhcp.lan.dhcp_option='a' 'b c'": shell-quoted by uci
	eval "for entry in ${raw#*=}; do printf '%s\\n' \"\$entry\"; done"
}

# Rewrite dhcp.lan.dhcp_option as: <vip entries given as $1 $2 ...>, then the
# entries in the newline separated $KS_OTHER_OPTIONS
ks_set_dhcp_options() {
	local entry

	uci -q delete dhcp.lan.dhcp_option
	for entry in "$@"; do
		uci add_list dhcp.lan.dhcp_option="$entry"
	done
	printf '%s\n' "$KS_OTHER_OPTIONS" | while IFS= read -r entry; do
		[ -n "$entry" ] && uci add_list dhcp.lan.dhcp_option="$entry"
	done
}

# split the current list: KS_VIP_OPTIONS (ours, space separated) and
# KS_OTHER_OPTIONS (the rest, one per line)
ks_split_dhcp_options() {
	local entry current

	KS_VIP_OPTIONS=""
	KS_OTHER_OPTIONS=""
	current=$(ks_dhcp_options)
	[ -n "$current" ] || return 0
	while IFS= read -r entry; do
		if ks_is_vip_option "$entry"; then
			KS_VIP_OPTIONS="${KS_VIP_OPTIONS:+$KS_VIP_OPTIONS }$entry"
		else
			KS_OTHER_OPTIONS="${KS_OTHER_OPTIONS:+$KS_OTHER_OPTIONS$KS_NL}$entry"
		fi
	done <<HEREDOC_END
$current
HEREDOC_END
}

# The virtual IP of the br-lan vrrp_instance, from the keepalived UCI config:
# instance -> its virtual_ipaddress reference -> the ipaddress section of that
# name -> address (without the prefix length)
ks_get_lan_vip() {
	local instance_line instance_key ip_ref section_line section_key vip_raw

	instance_line=$(uci -q show keepalived 2>/dev/null | grep "@vrrp_instance" | grep "interface='br-lan'" | head -n 1)
	if [ -z "$instance_line" ]; then
		ks_log "ERROR: Could not find vrrp_instance for interface 'br-lan'."
		return 1
	fi
	instance_key=$(echo "$instance_line" | cut -d'=' -f 1 | cut -d'.' -f 1,2)
	ip_ref=$(uci -q get "${instance_key}.virtual_ipaddress" 2>/dev/null)
	ip_ref=${ip_ref%% *}

	section_line=$(uci -q show keepalived 2>/dev/null | grep "@ipaddress" | grep "name='${ip_ref}'" | head -n 1)
	if [ -z "$section_line" ]; then
		ks_log "ERROR: Could not find @ipaddress section matching reference '${ip_ref}'."
		return 1
	fi
	section_key=$(echo "$section_line" | cut -d'=' -f 1 | cut -d'.' -f 1,2)
	vip_raw=$(uci -q get "${section_key}.address" 2>/dev/null)
	if [ -z "$vip_raw" ]; then
		ks_log "ERROR: Could not retrieve LAN VIP from UCI config (address field empty)."
		return 1
	fi
	echo "${vip_raw%%/*}"
}

# DHCPv4 on, gateway and DNS handed out as the LAN VIP
ks_enable_dhcpv4() {
	local vip

	vip=$(ks_get_lan_vip)
	if [ $? -ne 0 ] || [ -z "$vip" ]; then
		ks_log "ERROR: Failed to get LAN VIP, DHCPv4 options not configured"
		return 1
	fi

	ks_split_dhcp_options
	if [ -z "$(ks_dhcp_lan ignore)" ] &&
		[ "$(ks_dhcp_lan dhcpv4)" = "server" ] &&
		[ "$(ks_dhcp_lan force)" = "1" ] &&
		[ "$KS_VIP_OPTIONS" = "3,$vip 6,$vip" ]; then
		ks_log "DHCPv4 already enabled with VIP=$vip, skipping"
		return 0
	fi

	uci -q delete dhcp.lan.ignore
	uci -q delete dhcp.lan.dhcpv4
	uci -q delete dhcp.lan.force
	uci set dhcp.lan.dhcpv4=server
	uci set dhcp.lan.force=1
	ks_set_dhcp_options "3,$vip" "6,$vip"
	uci commit dhcp.lan
	ks_log "*** Enable DHCPv4 and DHCP option (VIP=$vip) ***"
}

# DHCPv4 off, dnsmasq itself keeps running for DNS
ks_disable_dhcpv4() {
	ks_split_dhcp_options
	if [ -z "$KS_VIP_OPTIONS" ] &&
		[ -z "$(ks_dhcp_lan force)" ] &&
		[ "$(ks_dhcp_lan dhcpv4)" = "disabled" ] &&
		[ "$(ks_dhcp_lan ignore)" = "1" ]; then
		ks_log "DHCPv4 already disabled, skipping"
		return 0
	fi

	uci -q delete dhcp.lan.force
	ks_set_dhcp_options
	uci set dhcp.lan.dhcpv4=disabled
	uci set dhcp.lan.ignore=1
	uci commit dhcp.lan
	ks_log "*** Cleared DHCP option ***"
}

# --- DHCPv6 / RA ---
ks_add_dhcpv6_ra_flags() {
	local flags ntp item

	flags=$(ks_cfg global ra_flags "managed-config other-config home-agent")
	ntp=$(ks_cfg global ntp "0.openwrt.pool.ntp.org 1.openwrt.pool.ntp.org 2.openwrt.pool.ntp.org 3.openwrt.pool.ntp.org")

	if [ "$(ks_dhcp_lan ra_flags)" = "$flags" ] &&
		[ "$(ks_dhcp_lan ntp)" = "$ntp" ]; then
		ks_log "DHCP RA flags already set, skipping"
		return 0
	fi

	uci -q delete dhcp.lan.ra_flags
	uci -q delete dhcp.lan.ntp
	for item in $flags; do
		uci add_list dhcp.lan.ra_flags="$item"
	done
	for item in $ntp; do
		uci add_list dhcp.lan.ntp="$item"
	done
	uci commit dhcp.lan
	ks_log "*** Setting DHCP RA flags ***"
}

ks_clear_dhcpv6_ra_flags() {
	if [ -z "$(ks_dhcp_lan ra_flags)" ] && [ -z "$(ks_dhcp_lan ntp)" ]; then
		ks_log "DHCP RA flags already cleared, skipping"
		return 0
	fi

	uci -q delete dhcp.lan.ra_flags
	uci -q delete dhcp.lan.ntp
	uci commit dhcp.lan
	ks_log "*** Cleared DHCP RA flags ***"
}

ks_enable_dhcpv6() {
	ks_check_and_update "dhcp.lan.dhcpv6" "server"
	ks_check_and_update "dhcp.lan.dhcpv6_pd" "1"
	ks_check_and_update "dhcp.lan.dhcpv6_pd_preferred" "1"
	ks_check_and_update "dhcp.lan.ra" "server"
	ks_check_and_update "dhcp.lan.ra_slaac" "0"
	ks_check_and_update "dhcp.lan.ra_preference" "high"
	ks_add_dhcpv6_ra_flags
}

ks_disable_dhcpv6() {
	ks_check_and_update "dhcp.lan.dhcpv6" "disabled"
	ks_check_and_update "dhcp.lan.dhcpv6_pd" "0"
	ks_check_and_update "dhcp.lan.dhcpv6_pd_preferred" "0"
	ks_check_and_update "dhcp.lan.ra" "disabled"
	ks_clear_dhcpv6_ra_flags
}

# --- Restart services whose config we just changed ---
ks_restart_dnsmasq() {
	ks_log "***** Restarting dnsmasq service *****"
	/etc/init.d/dnsmasq restart 2>/dev/null || ks_log "Error restarting dnsmasq"
}

ks_restart_odhcpd() {
	ks_log "***** Restarting odhcpd service *****"
	/etc/init.d/odhcpd restart 2>/dev/null || ks_log "Error restarting odhcpd"
}

# The "sync" section may be missing in a config from before it existed
ks_ensure_sync_section() {
	uci -q get "$KS_CONFIG.sync" >/dev/null 2>&1 || uci set "$KS_CONFIG.sync=$KS_CONFIG"
}

# --- lease_sync: pushes this node's leases and dhcp config to the peer ---
ks_lease_sync() {
	case "$1" in
		on)
			ks_log "Starting Procd lease sync service (Silent Mode)"
			ks_ensure_sync_section
			uci set "$KS_CONFIG.sync.enable=1"
			uci commit "$KS_CONFIG"
			/etc/init.d/lease_sync restart
			;;
		off)
			# "stop" of a procd service that is not registered makes
			# ubus print "Command failed: ... (Not found)"
			if /etc/init.d/lease_sync running >/dev/null 2>&1; then
				ks_log "Stopping Procd lease sync service"
				/etc/init.d/lease_sync stop
			else
				ks_log "Procd lease sync service is not running, nothing to stop"
			fi
			ks_ensure_sync_section
			uci set "$KS_CONFIG.sync.enable=0"
			uci commit "$KS_CONFIG"
			;;
	esac
}

# A node that becomes Master first takes the peer's leases, so the dnsmasq
# restart that follows loads the latest ones. Runs in the foreground (it is
# bounded by a ping check and the rsync timeout) so it is finished before
# dnsmasq is restarted.
ks_pull_leases_from_peer() {
	ks_log "Pulling DHCP leases from peer before enabling DHCP"
	"$KS_SCRIPTS_DIR/sync_leases.sh" pull || ks_log "Lease pull skipped or failed, continuing with local leases"
}

# The dhcp config too (hosts, tags, ...; not the role switches on dhcp.lan): the peer was Master until now and may hold
# edits this node has not seen. Written only when it differs; dnsmasq is
# restarted further down anyway, so it is not restarted here.
ks_pull_dhcp_from_peer() {
	ks_log "Pulling the dhcp config from peer before enabling DHCP"
	"$KS_SCRIPTS_DIR/sync_leases.sh" pull_dhcp "" norestart || ks_log "dhcp config pull skipped or failed, continuing with the local one"
}

# For the first BACKUP after keepalived started: is the group still BACKUP?
# 01-ubus has already recorded every event in STATUS. If it is unreadable,
# trust the event we were called for.
ks_still_backup() {
	local state

	state=$(cat "$KS_STATUS_DIR/${NAME}_${TYPE}/STATUS" 2>/dev/null)
	[ -z "$state" ] || [ "$state" = "NOTIFY_BACKUP" ]
}

# --- State handlers ---

# One service, one action
ks_do() {
	local svc="$1" act="$2"

	[ "$act" = keep ] && return 0

	case "$svc" in
		dhcpv4 | dhcpv6) ks_have_lan || return 0 ;;
	esac

	case "$svc:$act" in
		dhcpv4:on) ks_enable_dhcpv4 || ks_log "DHCPv4 was not enabled, see error above" ;;
		dhcpv4:off) ks_disable_dhcpv4 ;;
		dhcpv6:on) ks_enable_dhcpv6 ;;
		dhcpv6:off) ks_disable_dhcpv6 ;;
		natmap:on) ks_enable_natmap ;;
		natmap:off) ks_disable_natmap ;;
		cloudflared:on) ks_enable_cloudflared ;;
		cloudflared:off) ks_disable_cloudflared ;;
		lease_sync:on) ks_lease_sync on ;;
		lease_sync:off) ks_lease_sync off ;;
	esac
}

# dnsmasq itself. "on": running, restarted when its config was just touched or
# leases / dhcp config were pulled, started when it is down. "off": stopped.
# "keep": never started or stopped, but a running one is still restarted when
# its config was touched, so that a change takes effect.
ks_apply_dnsmasq() {
	local act="$1" dhcpv4_act="$2" pulled="$3" changed=0 running=0

	[ "$dhcpv4_act" != keep ] || [ "$pulled" -eq 1 ] && changed=1
	/etc/init.d/dnsmasq running >/dev/null 2>&1 && running=1

	case "$act" in
		on)
			if [ "$changed" -eq 1 ] || [ "$running" -eq 0 ]; then
				ks_restart_dnsmasq
			fi
			;;
		off)
			[ "$running" -eq 1 ] && ks_stop_service dnsmasq
			;;
		keep)
			if [ "$changed" -eq 1 ] && [ "$running" -eq 1 ]; then
				ks_restart_dnsmasq
			fi
			;;
	esac
}

# The actions of a state, in this order: take over the peer's data (Master
# only), DHCPv4 + dnsmasq, natmap, lease_sync, DHCPv6 + odhcpd, cloudflared.
# odhcpd is restarted only when its config was touched; dnsmasq see
# ks_apply_dnsmasq.
ks_apply_state() {
	local state="$1" pulled=0 act

	if [ "$state" = master ]; then
		if [ "$(ks_action master pull_leases)" = on ]; then
			ks_pull_leases_from_peer
			pulled=1
		fi
		if [ "$(ks_action master pull_dhcp)" = on ]; then
			ks_pull_dhcp_from_peer
			pulled=1
		fi
	fi

	act=$(ks_action "$state" dhcpv4)
	ks_do dhcpv4 "$act"
	ks_apply_dnsmasq "$(ks_action "$state" dnsmasq)" "$act" "$pulled"

	ks_do natmap "$(ks_action "$state" natmap)"
	ks_do lease_sync "$(ks_action "$state" lease_sync)"

	act=$(ks_action "$state" dhcpv6)
	ks_do dhcpv6 "$act"
	[ "$act" = keep ] || ks_restart_odhcpd

	ks_do cloudflared "$(ks_action "$state" cloudflared)"
}

ks_on_master() {
	rm -f "$KS_INITIAL_FLAG"
	ks_log "Keepalived state is MASTER, enabling services"
	ks_apply_state master
}

ks_on_backup() {
	local delay

	if [ -f "$KS_INITIAL_FLAG" ]; then
		delay=$(ks_cfg global settle_delay "$KS_SETTLE_DELAY")
		ks_log "*** Detected initial NOTIFY_BACKUP after Keepalived start, delaying execution ***"
		sleep "$delay"
		rm -f "$KS_INITIAL_FLAG"

		if ! ks_still_backup; then
			ks_log "*** After delay, Keepalived is no longer in BACKUP state, skipping NOTIFY_BACKUP execution ***"
			return 0
		fi
		ks_log "*** After delay, Keepalived is still in BACKUP state, executing NOTIFY_BACKUP logic ***"
	fi

	ks_log "Keepalived state is BACKUP, disabling services"
	ks_apply_state backup
}

ks_on_fault() {
	rm -f "$KS_INITIAL_FLAG"
	ks_log "Keepalived state is FAULT, disabling services"
	ks_apply_state fault
}

ks_main() {
	if [ "$(ks_flag global enabled 1)" -ne 1 ]; then
		ks_log "Disabled in $KS_CONFIG (global.enabled), ignoring ACTION=$ACTION TYPE=$TYPE"
		return 0
	fi

	ks_log "Keepalived state changed: TYPE=$TYPE, NAME=$NAME, ACTION=$ACTION"

	# startup/shutdown come from keepalived's startup_script/shutdown_script
	case "$ACTION" in
		shutdown)
			ks_log "*** Keepalived is shutting down ***"
			[ "$(ks_flag shutdown clear_ra_flags 1)" -eq 1 ] && ks_have_lan && ks_clear_dhcpv6_ra_flags
			ks_apply_dnsmasq "$(ks_action shutdown dnsmasq)" keep 0
			ks_do cloudflared "$(ks_action shutdown cloudflared)"
			ks_do natmap "$(ks_action shutdown natmap)"
			rm -f "$KS_INITIAL_FLAG"
			return 0
			;;
		startup)
			ks_log "***** Keepalived is starting, marking initial start *****"
			touch "$KS_INITIAL_FLAG"
			return 0
			;;
	esac

	# Every transition fires for both the vrrp_instance and the
	# vrrp_sync_group; only act on the GROUP to avoid running twice.
	[ "$TYPE" = "GROUP" ] || return 0

	case "$ACTION" in
		NOTIFY_MASTER) ks_on_master ;;
		NOTIFY_BACKUP) ks_on_backup ;;
		NOTIFY_FAULT) ks_on_fault ;;
	esac
}

ks_main
